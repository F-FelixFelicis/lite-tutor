# Optional: the UI can pass the key to the local backend without saving it.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE=https://api.deepseek.com/v1

# Stable offline retrieval is the default. Set to false only if you want to
# download and use the sentence-transformer embedding model.
LITETUTOR_OFFLINE=true
LITETUTOR_RAG_DB=./chroma_db
LITETUTOR_LEARNING_DB=./user_learning_db.json
LITETUTOR_UPLOAD_DIR=./uploads

# Disabled by default because a subprocess is not a complete security sandbox.
LITETUTOR_ENABLE_CODE_EXECUTION=false

LITETUTOR_MAX_PDF_MB=20
RAG_CONF_THRESHOLD=0.35

# The backend is local-only by default. Change the host only when you have
# added appropriate network access controls.
LITETUTOR_HOST=127.0.0.1
LITETUTOR_PORT=8000
